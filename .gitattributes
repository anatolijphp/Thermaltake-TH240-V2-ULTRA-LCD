# shell scripts and Linux packaging files must keep LF line endings
*.sh text eol=lf
linux/* text eol=lf
# images are binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
# batch files: CRLF, so cmd.exe finds every :label (its label search can miss labels in LF-only files)
/*.cmd text eol=crlf
/rs/*.cmd text eol=crlf
