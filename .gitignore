# build output (build.cmd / CI produce these from source): build\<os>\
/build/
*.exe
*.pdb
*.old
*.dll
!/driver/*.dll

# third-party tools (portable Ghidra, JDK, Nuvoton TurboWriter, downloads)
/tools/

# reverse-engineering workspace: Ghidra projects, outputs and vendor binaries stay local
/extras/re/*
!/extras/re/scripts/
!/extras/re/*.cmd

# flash dumps and logs (the firmware we ship is in firmware/, see the exception below)
*.bin
*.log
!/firmware/*.bin
# the idle-screen glyphs copied from that firmware (src/core/src/idle_text.rs)
!/src/core/fonts/*.bin

# Studio UI build: npm packages (pinned by src/studio/ui/package-lock.json) and the local bundle
/src/studio/ui/node_modules/
/src/studio/ui/dist/
