<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TT LCD Studio" Width="1240" Height="792" MinWidth="1100" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#070707"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#070707"/>
    <SolidColorBrush x:Key="Panel" Color="#0D0D0E"/>
    <SolidColorBrush x:Key="Card" Color="#131314"/>
    <SolidColorBrush x:Key="CardHi" Color="#1B1B1D"/>
    <SolidColorBrush x:Key="Line" Color="#29292C"/>
    <SolidColorBrush x:Key="LineHi" Color="#46464B"/>
    <SolidColorBrush x:Key="Text" Color="#EDEDED"/>
    <SolidColorBrush x:Key="Dim" Color="#8F8F94"/>
    <SolidColorBrush x:Key="Accent" Color="#FF1F4B"/>
    <SolidColorBrush x:Key="Accent2" Color="#00E1FF"/>
    <!-- live status text (fps, game mode, idle upload): a soft tint of the accent -->
    <SolidColorBrush x:Key="StatusText" Color="#FF7A90"/>
    <SolidColorBrush x:Key="AccentDim" Color="#4A1020"/>
    <Color x:Key="AccentC">#FF1F4B</Color>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <LinearGradientBrush x:Key="Rgb" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF1F4B" Offset="0"/>
      <GradientStop Color="#FF8A00" Offset="0.17"/>
      <GradientStop Color="#FFE600" Offset="0.33"/>
      <GradientStop Color="#2BE36B" Offset="0.5"/>
      <GradientStop Color="#00E1FF" Offset="0.67"/>
      <GradientStop Color="#7A4BFF" Offset="0.83"/>
      <GradientStop Color="#FF2BD6" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Glow" Color="#FF1F4B" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
    <DropShadowEffect x:Key="GlowSoft" Color="#FF1F4B" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,18"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- section heading inside a card: caption with a hairline above -->
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,18,0,12"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hair" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{StaticResource Line}"/>
      <Setter Property="Margin" Value="0,18,0,0"/>
    </Style>

    <!-- card: cut top-right corner, red-to-cyan tick -->
    <Style x:Key="CardBox" TargetType="ContentControl">
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Path Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Stroke="{StaticResource Line}" StrokeThickness="1">
                <Path.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#151516" Offset="0"/>
                    <GradientStop Color="#0F0F10" Offset="1"/>
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
              <Rectangle Width="44" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1F4B" Offset="0"/>
                    <GradientStop Color="#00FF1F4B" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Polygon Points="0,0 14,0 14,14" Fill="{StaticResource Bg}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
              <Line X1="0" Y1="0" X2="14" Y2="14" Stroke="{StaticResource Line}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
              <ContentPresenter Margin="20,18,20,18"/>
              <!-- highlight, flashed from code (App.FlashCard) when a link jumps to this card -->
              <Path x:Name="flash" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                    Fill="#14FF1F4B" Opacity="0" IsHitTestVisible="False">
                <Path.Effect><DropShadowEffect Color="#FF1F4B" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
              </Path>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource CardHi}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="b" Property="Effect" Value="{StaticResource GlowSoft}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- title-bar on/off button (game mode) -->
    <Style x:Key="TitleToggle" TargetType="ToggleButton">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="Transparent">
              <TextBlock x:Name="ic" Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="ic" Property="Effect" Value="{StaticResource Glow}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- left navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="g" Height="50" Background="Transparent">
              <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Hidden" Effect="{StaticResource Glow}"/>
              <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                <TextBlock x:Name="tx" Text="{TemplateBinding Content}" Margin="14,0,0,0" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Background" Value="#0DFFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="g" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#33FF1F4B" Offset="0"/>
                      <GradientStop Color="#00FF1F4B" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="ic" Property="Effect" Value="{StaticResource GlowSoft}"/>
                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- mode tiles (in a responsive UniformGrid) -->
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="GroupName" Value="mode"/>
      <Setter Property="Height" Value="96"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3"/>
              <Rectangle x:Name="rgb" Height="2" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{StaticResource Rgb}" Visibility="Hidden"/>
              <Polygon x:Name="corner" Points="0,0 12,0 0,12" Fill="{StaticResource Accent}" Visibility="Hidden"/>
              <StackPanel VerticalAlignment="Center">
                <!-- icon: a glyph string (icon font) or a shape (Path with Fill bound to TextElement.Foreground) -->
                <ContentPresenter x:Name="ic" Content="{TemplateBinding Tag}" HorizontalAlignment="Center" Height="30"
                                  TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="26" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <TextBlock x:Name="tx" Text="{TemplateBinding Content}" Margin="0,6,0,0" FontSize="12" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHi}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineHi}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="b" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#40FF1F4B" Offset="0"/>
                      <GradientStop Color="#14FF1F4B" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="b" Property="Effect" Value="{StaticResource Glow}"/>
                <Setter TargetName="rgb" Property="Visibility" Value="Visible"/>
                <Setter TargetName="corner" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ic" Property="TextElement.Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- segmented buttons -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <!-- one option of a segmented toggle: groups are wrapped in a rounded track at load (App.WrapSegGroups) -->
            <Border x:Name="b" Background="Transparent" Padding="14,5" CornerRadius="13">
              <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <!-- the red pill behind the selected option slides between options (App.WrapSegGroups) -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="Transparent"/>
                <Setter TargetName="t" Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle switch: only the switch and its text are clickable -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <!-- iOS-style switch: the knob slides (eased) and the red track fades in -->
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="40" Height="20">
                <Border x:Name="track" CornerRadius="10" Background="#2C2C2F" BorderThickness="1" BorderBrush="Transparent"/>
                <Border x:Name="on" CornerRadius="10" Background="{StaticResource Accent}" Opacity="0"/>
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#CFCFD2" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="slide"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <!-- hover: lighter track and a red rim -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="Background" Value="#3A3A3F"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="on" Property="Effect" Value="{StaticResource GlowSoft}"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
              <!-- hover while on: brighter, stronger glow -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="on" Property="Background" Value="#FF3D63"/>
                <Setter TargetName="on" Property="Effect" Value="{StaticResource Glow}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- chip: compact on/off pill used for "what to show" groups -->
    <Style x:Key="Chip" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="b" Background="{StaticResource CardHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="11,6,14,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ic" Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
                <TextBlock x:Name="tx" Text="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineHi}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="#2EFF1F4B"/>
                <Setter TargetName="b" Property="Effect" Value="{StaticResource GlowSoft}"/>
                <Setter TargetName="ic" Property="Text" Value="&#xE73E;"/>
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small square icon button (reorder arrows) -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHi}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.25"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slider: thin track, gradient fill, diamond thumb -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"><Rectangle Height="3" Fill="{TemplateBinding Background}"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="26"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.DecreaseLarge">
                  <RepeatButton.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#7A1028" Offset="0"/>
                      <GradientStop Color="#FF1F4B" Offset="1"/>
                    </LinearGradientBrush>
                  </RepeatButton.Background>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRepeat}" Background="#2C2C2F" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="16" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Rectangle Width="11" Height="11" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource GlowSoft}">
                        <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                      </Rectangle>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B0B0C"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- combobox -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="#0B0B0C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#18181A" BorderBrush="{StaticResource Line}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                  <ScrollViewer><VirtualizingStackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Padding="10,7" Background="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#33FF1F4B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#29292C"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#404044" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- scroll viewer whose (thin) scrollbar floats over the content instead of taking width; it is faded in/out in code -->
    <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
              <ScrollContentPresenter Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="5" MinWidth="0" Margin="0,6,3,6"
                         Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Cursor="Arrow"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- round colour swatch -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="ring" Stroke="{StaticResource LineHi}" StrokeThickness="1" Fill="{TemplateBinding Background}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="White"/>
                <Setter TargetName="ring" Property="StrokeThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- title bar -->
    <Grid Background="#050505">
      <Polygon Points="0,0 252,0 228,48 0,48" Fill="#0D0D0E"/>
      <Polygon Points="252,0 264,0 240,48 228,48" Fill="{StaticResource Accent}" Effect="{StaticResource Glow}"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
        <TextBlock Text="TT" FontWeight="Black" FontSize="19" Foreground="{StaticResource Accent}" Effect="{StaticResource GlowSoft}"/>
        <TextBlock Text=" LCD STUDIO" FontWeight="SemiBold" FontSize="15" Margin="2,2,0,0"/>
      </StackPanel>
      <TextBlock x:Name="TitleStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ToggleButton x:Name="GameBtn" Style="{StaticResource TitleToggle}" Content="&#xE7FC;" ToolTip="Game mode: force on (for games that aren't detected)"/>
        <Button x:Name="MinBtn" Style="{StaticResource ChromeBtn}" Content="&#xE921;"/>
        <Button x:Name="FullBtn" Style="{StaticResource ChromeBtn}" Content="&#xE740;" ToolTip="Full screen (F11)"/>
        <Button x:Name="CloseBtn" Style="{StaticResource ChromeBtn}" Content="&#xE8BB;"/>
      </StackPanel>
      <!-- flowing RGB line -->
      <Rectangle Height="2" VerticalAlignment="Bottom" Opacity="0.9">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,0" SpreadMethod="Repeat">
            <LinearGradientBrush.RelativeTransform><TranslateTransform/></LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#FF1F4B" Offset="0"/>
            <GradientStop Color="#FF8A00" Offset="0.17"/>
            <GradientStop Color="#FFE600" Offset="0.33"/>
            <GradientStop Color="#2BE36B" Offset="0.5"/>
            <GradientStop Color="#00E1FF" Offset="0.67"/>
            <GradientStop Color="#7A4BFF" Offset="0.83"/>
            <GradientStop Color="#FF1F4B" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.Effect><DropShadowEffect Color="#FF2BD6" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></Rectangle.Effect>
        <Rectangle.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(Rectangle.Fill).(Brush.RelativeTransform).(TranslateTransform.X)" From="0" To="0.5" Duration="0:0:6" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Rectangle.Triggers>
      </Rectangle>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavCol" Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>
      <!-- faint red bloom behind the content -->
      <Rectangle Grid.Column="1" Grid.ColumnSpan="2" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.7" RadiusY="0.6">
            <GradientStop Color="#1AFF1F4B" Offset="0"/>
            <GradientStop Color="#00FF1F4B" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- navigation -->
      <Border x:Name="NavPanel" Width="214" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" ClipToBounds="True">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <Button x:Name="NavToggle" Style="{StaticResource IconBtn}" Content="&#xE700;" FontSize="16" Width="40" Height="40" HorizontalAlignment="Left" Margin="13,0,0,8"/>
            <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" Content="Dashboard" Tag="&#xE9D9;" IsChecked="True"/>
            <RadioButton x:Name="NavModes" Style="{StaticResource Nav}" Content="Display modes" Tag="&#xE8A9;"/>
            <RadioButton x:Name="NavDevice" Style="{StaticResource Nav}" Content="Device" Tag="&#xE706;"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="Settings" Tag="&#xE713;"/>
          </StackPanel>
          <StackPanel x:Name="NavFooter" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="24,0,0,20">
            <Rectangle Height="2" Width="36" HorizontalAlignment="Left" Fill="{StaticResource Rgb}" Margin="0,0,0,10"/>
            <TextBlock Text="TH240 V2 Ultra · CL-W383" Foreground="{StaticResource Dim}" FontSize="11"/>
            <TextBlock x:Name="NavSerial" Foreground="{StaticResource Dim}" FontSize="11"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- pages -->
      <ScrollViewer x:Name="PageScroll" Grid.Column="1" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Padding="30,24,24,10">
        <Grid>
          <!-- ===== Modes page ===== -->
          <StackPanel x:Name="PageModes" Visibility="Collapsed">
            <TextBlock Text="Display modes" Style="{StaticResource H1}"/>
            <TextBlock Text="Choose what the cooler screen shows. Changes apply instantly." Style="{StaticResource Sub}"/>
            <UniformGrid x:Name="ModeTiles" Columns="5" Margin="0,0,-10,8">
              <RadioButton x:Name="ModeOff" Style="{StaticResource Tile}" Content="Off" Tag="&#xE7E8;"/>
              <RadioButton x:Name="ModeVirtualDisplay" Style="{StaticResource Tile}" Content="Wallpaper Engine" Tag="&#xE7F4;"/>
              <RadioButton x:Name="ModeMonitor" Style="{StaticResource Tile}" Content="Screen mirror" Tag="&#xE7C4;"/>
              <RadioButton x:Name="ModeImage" Style="{StaticResource Tile}" Content="Image" Tag="&#xE8B9;"/>
              <RadioButton x:Name="ModeGif" Style="{StaticResource Tile}" Content="GIF" Tag="&#xE768;"/>
              <RadioButton x:Name="ModeVideo" Style="{StaticResource Tile}" Content="Video" Tag="&#xE714;"/>
              <RadioButton x:Name="ModeColor" Style="{StaticResource Tile}" Content="Colour" Tag="&#xE790;"/>
              <RadioButton x:Name="ModeClock" Style="{StaticResource Tile}" Content="Clock" Tag="&#xE823;"/>
              <RadioButton x:Name="ModeAura" Style="{StaticResource Tile}" Content="Aura Sync">
                <!-- Aura Sync style mark: an angular "A" of two stripes with a cut-out crossbar -->
                <RadioButton.Tag>
                  <Path Width="28" Height="26" Stretch="Uniform"
                        Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                        Data="M 12,1 L 23,22 L 18.5,22 L 12,9.5 L 5.5,22 L 1,22 Z M 12,13 L 15.6,20 L 8.4,20 Z"/>
                </RadioButton.Tag>
              </RadioButton>
            </UniformGrid>

            <!-- per-mode options -->
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock x:Name="OptTitle" Text="OPTIONS" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="OptDesc" Style="{StaticResource Sub}" Margin="0,0,0,12"/>

                <StackPanel x:Name="OptVirtualDisplay">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="VdStatus1" Style="{StaticResource Label}"/>
                    <Button x:Name="VdGoDevice" Style="{StaticResource Btn}" Content="Manage virtual display"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="OptMonitor">
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Monitor" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="MonitorBox" Grid.Column="1" VerticalAlignment="Center"/>
                  </Grid>
                  <CheckBox x:Name="RegionSwitch" Style="{StaticResource Switch}" Content="Only a region of the monitor" Margin="0,0,0,10"/>
                  <StackPanel x:Name="RegionRow" Orientation="Horizontal">
                    <TextBlock Text="X" Style="{StaticResource Label}"/><TextBox x:Name="RegX" Width="64" Margin="0,0,14,0"/>
                    <TextBlock Text="Y" Style="{StaticResource Label}"/><TextBox x:Name="RegY" Width="64" Margin="0,0,14,0"/>
                    <TextBlock Text="W" Style="{StaticResource Label}"/><TextBox x:Name="RegW" Width="64" Margin="0,0,14,0"/>
                    <TextBlock Text="H" Style="{StaticResource Label}"/><TextBox x:Name="RegH" Width="64"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="OptImage">
                  <DockPanel>
                    <Button x:Name="ImageBrowse" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Browse…" Margin="8,0,0,0"/>
                    <TextBox x:Name="ImagePath" IsReadOnly="True"/>
                  </DockPanel>
                </StackPanel>

                <StackPanel x:Name="OptGif">
                  <DockPanel>
                    <Button x:Name="GifBrowse" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Browse…" Margin="8,0,0,0"/>
                    <TextBox x:Name="GifPath" IsReadOnly="True"/>
                  </DockPanel>
                </StackPanel>

                <StackPanel x:Name="OptVideo">
                  <DockPanel Margin="0,0,0,12">
                    <Button x:Name="VideoBrowse" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Browse…" Margin="8,0,0,0"/>
                    <TextBox x:Name="VideoPath" IsReadOnly="True"/>
                  </DockPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <TextBlock Text="Start" Style="{StaticResource Label}"/>
                      <Slider x:Name="VStart" Grid.Column="1" Minimum="0" Maximum="30"/>
                      <TextBlock x:Name="VStartT" Grid.Column="2" Style="{StaticResource Value}"/>
                      <TextBlock Grid.Row="1" Text="Length" Style="{StaticResource Label}"/>
                      <Slider x:Name="VLength" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="30"/>
                      <TextBlock x:Name="VLengthT" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"/>
                      <TextBlock Grid.Row="2" Text="Zoom" Style="{StaticResource Label}"/>
                      <Slider x:Name="VZoom" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="4"/>
                      <TextBlock x:Name="VZoomT" Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}"/>
                      <TextBlock Grid.Row="3" Text="Pan X" Style="{StaticResource Label}"/>
                      <Slider x:Name="VPanX" Grid.Row="3" Grid.Column="1" Minimum="-1" Maximum="1"/>
                      <TextBlock Grid.Row="4" Text="Pan Y" Style="{StaticResource Label}"/>
                      <Slider x:Name="VPanY" Grid.Row="4" Grid.Column="1" Minimum="-1" Maximum="1"/>
                      <TextBlock Grid.Row="5" Text="FPS" Style="{StaticResource Label}"/>
                      <Slider x:Name="VFps" Grid.Row="5" Grid.Column="1" Minimum="5" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"/>
                      <TextBlock x:Name="VFpsT" Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                      <Grid Width="150" Height="150">
                        <Ellipse Fill="Black" Stroke="{StaticResource Line}"/>
                        <Image x:Name="VThumb" Stretch="Uniform">
                          <Image.Clip><EllipseGeometry Center="75,75" RadiusX="74" RadiusY="74"/></Image.Clip>
                        </Image>
                      </Grid>
                      <TextBlock x:Name="VInfo" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                  <ProgressBar x:Name="VProgress" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel x:Name="OptAura">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AuraStatus" Style="{StaticResource Label}" MinWidth="140"/>
                    <Button x:Name="AuraInstall" Style="{StaticResource AccentBtn}" Content="Install plugin" Margin="0,0,8,0"/>
                    <Button x:Name="AuraUninstall" Style="{StaticResource Btn}" Content="Uninstall"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="OptOff"/>

                <StackPanel x:Name="OptClock">
                  <Rectangle Style="{StaticResource Hair}"/>
                  <TextBlock Text="PLACEMENT" Style="{StaticResource Section}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="Where the readings sit. Everything is kept inside the round screen: text that would cross the edge is shrunk automatically."/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                    <TextBlock Text="Alignment" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="AlignL" Style="{StaticResource Seg}" Content="Left" GroupName="align"/>
                      <RadioButton x:Name="AlignC" Style="{StaticResource Seg}" Content="Centre" GroupName="align"/>
                      <RadioButton x:Name="AlignR" Style="{StaticResource Seg}" Content="Right" GroupName="align"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Vertical offset" Style="{StaticResource Label}"/>
                    <Slider x:Name="ClkOffset" Grid.Row="1" Grid.Column="1" Minimum="-160" Maximum="160" IsSnapToTickEnabled="True" TickFrequency="2" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClkOffsetT" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"/>
                    <TextBlock Grid.Row="2" Text="Line spacing" Style="{StaticResource Label}"/>
                    <Slider x:Name="ClkSpacing" Grid.Row="2" Grid.Column="1" Minimum="-20" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClkSpacingT" Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}"/>
                  </Grid>
                  <Rectangle Style="{StaticResource Hair}"/>
                  <TextBlock Text="ELEMENTS" Style="{StaticResource Section}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                             Text="Each row is a line on the screen. Drag a reading onto a line to put it beside the others, or between lines to give it its own line. The dot turns a reading on or off; click a reading to style it."/>
                  <Grid x:Name="ClkItems"/>
                </StackPanel>

                <!-- shared options -->
                <StackPanel x:Name="OptScaling" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Scaling" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="ScaleFill" Style="{StaticResource Seg}" Content="Fill" GroupName="scale"/>
                      <RadioButton x:Name="ScaleFit" Style="{StaticResource Seg}" Content="Fit" GroupName="scale"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="OptBg" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Background" Style="{StaticResource Label}"/>
                    <WrapPanel x:Name="BgSwatches" Grid.Column="1" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="OptOverlay">
                  <Rectangle Style="{StaticResource Hair}"/>
                  <StackPanel x:Name="OvDetails">
                  <TextBlock Text="OVERLAY · PLACEMENT" Style="{StaticResource Section}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="Time and temperatures drawn on top of this mode."/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                    <TextBlock Text="Vertical" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="OvTop" Style="{StaticResource Seg}" Content="Top" GroupName="ovpos"/>
                      <RadioButton x:Name="OvCentre" Style="{StaticResource Seg}" Content="Centre" GroupName="ovpos"/>
                      <RadioButton x:Name="OvBottom" Style="{StaticResource Seg}" Content="Bottom" GroupName="ovpos"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Alignment" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="OvAlignL" Style="{StaticResource Seg}" Content="Left" GroupName="ovalign"/>
                      <RadioButton x:Name="OvAlignC" Style="{StaticResource Seg}" Content="Centre" GroupName="ovalign"/>
                      <RadioButton x:Name="OvAlignR" Style="{StaticResource Seg}" Content="Right" GroupName="ovalign"/>
                    </StackPanel>
                  </Grid>
                  </StackPanel>
                  <TextBlock Text="OVERLAY · ELEMENTS" Style="{StaticResource Section}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                             Text="Each row is a line. Drag readings between lines to arrange them. The dot turns a reading on or off; click a reading to style it."/>
                  <Grid x:Name="OvItems"/>
                </StackPanel>

                <!-- style of the selected reading (shown only while one is selected) -->
                <StackPanel x:Name="OptText" Visibility="Collapsed">
                  <Rectangle Style="{StaticResource Hair}"/>
                  <TextBlock x:Name="StTitle" Text="TEXT STYLE" Style="{StaticResource Section}"/>
                  <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="How the selected reading looks. Each reading has its own style."/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                    <TextBlock Text="Font" Style="{StaticResource Label}"/>
                    <DockPanel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                      <CheckBox x:Name="TxtItalic" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="Italic" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      <CheckBox x:Name="TxtBold" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                      <ComboBox x:Name="TxtFont" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Label}"/>
                    <Slider x:Name="StSize" Grid.Row="1" Grid.Column="1" Minimum="12" Maximum="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StSizeT" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"/>
                    <TextBlock Grid.Row="2" Text="Effect" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="FxNone" Style="{StaticResource Seg}" Content="None" GroupName="fx"/>
                      <RadioButton x:Name="FxShadow" Style="{StaticResource Seg}" Content="Shadow" GroupName="fx"/>
                      <RadioButton x:Name="FxOutline" Style="{StaticResource Seg}" Content="Outline" GroupName="fx"/>
                      <RadioButton x:Name="FxGlow" Style="{StaticResource Seg}" Content="Neon glow" GroupName="fx"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Colour" Style="{StaticResource Label}"/>
                    <WrapPanel x:Name="TextSwatches" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StUnitsLabel" Grid.Row="4" Text="Units" Style="{StaticResource Label}"/>
                    <StackPanel x:Name="StUnits" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="UnitC" Style="{StaticResource Seg}" Content="°C" GroupName="unit"/>
                      <RadioButton x:Name="UnitF" Style="{StaticResource Seg}" Content="°F" GroupName="unit"/>
                    </StackPanel>
                    <TextBlock x:Name="StReadingLabel" Grid.Row="5" Text="Reading" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                    <WrapPanel x:Name="StReading" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <RadioButton x:Name="LblNone" Style="{StaticResource Seg}" Content="No label" GroupName="lbl"/>
                        <RadioButton x:Name="LblBeside" Style="{StaticResource Seg}" Content="Coolant: 31°C" GroupName="lbl"/>
                        <RadioButton x:Name="LblAbove" Style="{StaticResource Seg}" Content="Label above" GroupName="lbl"/>
                      </StackPanel>
                      <CheckBox x:Name="TxtByTemp" Style="{StaticResource Switch}" Content="Colour by value" VerticalAlignment="Center"/>
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </ContentControl>
          </StackPanel>

          <!-- ===== Dashboard page (in-app monitoring) ===== -->
          <StackPanel x:Name="PageDashboard">
            <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
            <TextBlock Text="Live readings. Coolant temperature comes from the cooler's own sensor; the rest are read from Windows." Style="{StaticResource Sub}"/>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="SENSORS" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="Choose which gauges the dashboard shows."/>
                <WrapPanel>
                  <CheckBox x:Name="DbShowWater" Style="{StaticResource Chip}" Content="Coolant temperature"/>
                  <CheckBox x:Name="DbShowCpuTemp" Style="{StaticResource Chip}" Content="CPU temperature"/>
                  <CheckBox x:Name="DbShowCpuLoad" Style="{StaticResource Chip}" Content="CPU load"/>
                  <CheckBox x:Name="DbShowRam" Style="{StaticResource Chip}" Content="RAM usage"/>
                </WrapPanel>
              </StackPanel>
            </ContentControl>
            <UniformGrid x:Name="DbTiles" Columns="3" Margin="0,0,-14,0">
              <ContentControl x:Name="DbTileWater" Style="{StaticResource CardBox}" Margin="0,0,14,14">
                <Viewbox MaxWidth="180" Stretch="Uniform">
                  <Grid Width="156" Height="156">
                    <Path x:Name="DbWaterTrack" Stroke="#242427" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="DbWaterArc" Stroke="#50B4FF" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Effect><DropShadowEffect Color="#50B4FF" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/></Path.Effect>
                    </Path>
                    <TextBlock Text="&#xE9CA;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#50B4FF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"/>
                    <TextBlock x:Name="DbWater" Text="--" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="COOLANT" FontSize="11" FontWeight="Bold" Foreground="#50B4FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                  </Grid>
                </Viewbox>
              </ContentControl>              <ContentControl x:Name="DbTileCpuTemp" Style="{StaticResource CardBox}" Margin="0,0,14,14">
                <Viewbox MaxWidth="180" Stretch="Uniform">
                  <Grid Width="156" Height="156">
                    <Path x:Name="DbCpuTempTrack" Stroke="#242427" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="DbCpuTempArc" Stroke="#FFAA3C" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Effect><DropShadowEffect Color="#FFAA3C" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/></Path.Effect>
                    </Path>
                    <TextBlock Text="&#xE9CA;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FFAA3C" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"/>
                    <TextBlock x:Name="DbCpuTemp" Text="--" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="CPU TEMP" FontSize="11" FontWeight="Bold" Foreground="#FFAA3C" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                  </Grid>
                </Viewbox>
              </ContentControl>              <ContentControl x:Name="DbTileCpuLoad" Style="{StaticResource CardBox}" Margin="0,0,14,14">
                <Viewbox MaxWidth="180" Stretch="Uniform">
                  <Grid Width="156" Height="156">
                    <Path x:Name="DbCpuLoadTrack" Stroke="#242427" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="DbCpuLoadArc" Stroke="#FF4B6E" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Effect><DropShadowEffect Color="#FF4B6E" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/></Path.Effect>
                    </Path>
                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF4B6E" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"/>
                    <TextBlock x:Name="DbCpuLoad" Text="--" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="CPU LOAD" FontSize="11" FontWeight="Bold" Foreground="#FF4B6E" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                  </Grid>
                </Viewbox>
              </ContentControl>              <ContentControl x:Name="DbTileRam" Style="{StaticResource CardBox}" Margin="0,0,14,14">
                <Viewbox MaxWidth="180" Stretch="Uniform">
                  <Grid Width="156" Height="156">
                    <Path x:Name="DbRamTrack" Stroke="#242427" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="DbRamArc" Stroke="#5BE38A" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Effect><DropShadowEffect Color="#5BE38A" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/></Path.Effect>
                    </Path>
                    <TextBlock Text="&#xEEA0;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#5BE38A" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"/>
                    <TextBlock x:Name="DbRam" Text="--" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="RAM" FontSize="11" FontWeight="Bold" Foreground="#5BE38A" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                  </Grid>
                </Viewbox>
              </ContentControl>                          </UniformGrid>
            <TextBlock x:Name="DbNote" Foreground="{StaticResource Dim}" FontSize="11" Margin="2,0,0,0"/>
            <TextBlock x:Name="CpuTempRow" Foreground="{StaticResource Dim}" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap">
              CPU temperature needs the sensors service:
              <Hyperlink x:Name="CpuTempLink" Foreground="{StaticResource StatusText}">set it up in Settings → Sensors</Hyperlink>
            </TextBlock>
          </StackPanel>

          <!-- ===== Device page ===== -->
          <StackPanel x:Name="PageDevice" Visibility="Collapsed">
            <TextBlock Text="Device" Style="{StaticResource H1}"/>
            <TextBlock Text="Screen settings that live on the cooler." Style="{StaticResource Sub}"/>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="SCREEN" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="Brightness, orientation and sleep. These are stored in the cooler."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                  <TextBlock Text="Brightness" Style="{StaticResource Label}"/>
                  <Slider x:Name="Bright" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                  <TextBlock x:Name="BrightT" Grid.Column="2" Style="{StaticResource Value}"/>
                  <TextBlock Grid.Row="1" Text="Rotation" Style="{StaticResource Label}"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="Rot0" Style="{StaticResource Seg}" Content="0°" GroupName="rot"/>
                    <RadioButton x:Name="Rot90" Style="{StaticResource Seg}" Content="90°" GroupName="rot"/>
                    <RadioButton x:Name="Rot180" Style="{StaticResource Seg}" Content="180°" GroupName="rot"/>
                    <RadioButton x:Name="Rot270" Style="{StaticResource Seg}" Content="270°" GroupName="rot"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="Sleep" Style="{StaticResource Label}"/>
                  <CheckBox x:Name="SleepSwitch" Grid.Row="2" Grid.Column="1" Style="{StaticResource Switch}" Content="Dim the screen when idle" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Rotation turns everything on the cooler to match how the pump is mounted: the live picture and the cooler's own idle and boot screens. Also the arrow on the preview."/>
              </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="VIRTUAL DISPLAY (WALLPAPER ENGINE)" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                           Text="Adds a 480×480 monitor that Wallpaper Engine can draw on. Requires administrator rights; uninstall removes the driver completely."/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="VdStatus2" Style="{StaticResource Label}" MinWidth="140"/>
                  <Button x:Name="VdInstall" Style="{StaticResource AccentBtn}" Content="Install" Margin="0,0,8,0"/>
                  <Button x:Name="VdUninstall" Style="{StaticResource Btn}" Content="Uninstall"/>
                </StackPanel>
              </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="CONNECTION" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="The cooler as Windows sees it over USB."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                  <TextBlock Text="Status" Style="{StaticResource Label}"/><TextBlock x:Name="DevStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Text="Serial" Style="{StaticResource Label}"/><TextBlock x:Name="DevSerial" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Text="Frame rate" Style="{StaticResource Label}"/><TextBlock x:Name="DevFps" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </ContentControl>
          </StackPanel>

          <!-- ===== Settings page ===== -->
          <StackPanel x:Name="PageSettings" Visibility="Collapsed">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Streaming quality and how the app starts." Style="{StaticResource Sub}"/>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="STREAMING" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="How often and how sharp the pictures sent to the cooler are. Lower values use less CPU."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                  <TextBlock Text="Frame rate (FPS)" Style="{StaticResource Label}" ToolTip="Screen mirror, Wallpaper Engine and Aura Sync"/>
                  <Slider x:Name="Fps" Grid.Column="1" Minimum="5" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                  <TextBlock x:Name="FpsT" Grid.Column="2" Style="{StaticResource Value}"/>
                  <TextBlock Grid.Row="1" Text="JPEG quality" Style="{StaticResource Label}"/>
                  <Slider x:Name="Quality" Grid.Row="1" Grid.Column="1" Minimum="40" Maximum="95" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QualityT" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"/>
                </Grid>
              </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="GAME MODE" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                           Text="Lowers the load while you play: fewer frames to the cooler and slower sensor polling, or no streaming at all (the cooler then shows its own idle screen)."/>
                <CheckBox x:Name="GmOn" Style="{StaticResource Switch}" Content="Detect running games" Margin="0,0,0,10"/>
                <CheckBox x:Name="GmForce" Style="{StaticResource Switch}" Content="Game mode on now (also the gamepad button in the title bar)" ToolTip="For games that aren't detected" Margin="0,0,0,14"/>
                <StackPanel x:Name="GmOptions">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/><RowDefinition MinHeight="44"/></Grid.RowDefinitions>
                    <TextBlock Text="Detect" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                    <TextBlock Grid.Row="5" Text="Ignore these apps" Style="{StaticResource Label}"/>
                    <TextBox x:Name="GmIgnore" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                             ToolTip="Exe names never treated as games, comma separated, for example: BongoCat" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                      <CheckBox x:Name="GmFullscreen" Style="{StaticResource Chip}" Content="Full-screen games"
                                ToolTip="Exclusive full-screen Direct3D games (what Windows reports to hold back notifications)" VerticalAlignment="Center"/>
                      <CheckBox x:Name="GmKnown" Style="{StaticResource Chip}" Content="Games known to Windows"
                                ToolTip="Games the Xbox Game Bar has recorded on this PC (includes borderless and windowed games)" VerticalAlignment="Center"/>
                      <CheckBox x:Name="GmBorderless" Style="{StaticResource Chip}" Content="Any full-screen window"
                                ToolTip="Any app covering its whole monitor in the foreground; also triggers on full-screen video" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="Also these apps" Style="{StaticResource Label}"/>
                    <TextBox x:Name="GmExtra" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,10"
                             ToolTip="Exe names, comma separated, for example: eldenring.exe, cs2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="While a game runs" Style="{StaticResource Label}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <RadioButton x:Name="GmActNone" Style="{StaticResource Seg}" Content="Keep going" GroupName="gmact"/>
                      <RadioButton x:Name="GmActLowerFps" Style="{StaticResource Seg}" Content="Lower frame rate" GroupName="gmact"/>
                      <RadioButton x:Name="GmActIdleScreen" Style="{StaticResource Seg}" Content="Show idle screen" GroupName="gmact"/>
                    </StackPanel>
                    <TextBlock x:Name="GmFpsLabel" Grid.Row="3" Text="Game frame rate" Style="{StaticResource Label}"/>
                    <Slider x:Name="GmFps" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GmFpsT" Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}"/>
                    <TextBlock Grid.Row="4" Text="Sensor updates" Style="{StaticResource Label}"/>
                    <Slider x:Name="GmSensor" Grid.Row="4" Grid.Column="1" Minimum="2" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GmSensorT" Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}"/>
                  </Grid>
                  <TextBlock x:Name="GmStatus" Foreground="{StaticResource StatusText}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </ContentControl>
            <ContentControl x:Name="SensorsCard" Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="SENSORS" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                           Text="CPU temperature comes from TOWEI's sensor driver, which needs administrator rights. The TT LCD sensors service runs it at every boot, so nothing has to be enabled again."/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SvcStatus" Style="{StaticResource Label}" MinWidth="140"/>
                  <Button x:Name="SvcInstall" Style="{StaticResource AccentBtn}" Content="Install service" Margin="0,0,8,0"/>
                  <Button x:Name="SvcUninstall" Style="{StaticResource Btn}" Content="Uninstall service"/>
                </StackPanel>
              </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource CardBox}">
              <StackPanel>
                <TextBlock Text="APPLICATION" Style="{StaticResource Caption}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12" Text="How the app starts and closes, and the files it keeps."/>
                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="Start with Windows (in tray)" Margin="0,0,0,12"/>
                <CheckBox x:Name="BlankSwitch" Style="{StaticResource Switch}" Content="Blank the screen when the app exits" Margin="0,0,0,12"/>
                <CheckBox x:Name="TrayCloseSwitch" Style="{StaticResource Switch}" Content="Keep running in the tray when the window closes"/>
                <Rectangle Style="{StaticResource Hair}"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button x:Name="ClearCache" Style="{StaticResource Btn}" Content="Clear video cache" Margin="0,0,8,0"/>
                  <Button x:Name="OpenConfig" Style="{StaticResource Btn}" Content="Open settings folder"/>
                </StackPanel>
                <TextBlock x:Name="CacheInfo" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0"/>
              </StackPanel>
            </ContentControl>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- preview: round, like the cooler's screen, inside a rotating RGB ring. Live = what is streamed now,
           Idle = the picture the cooler shows by itself (stored in its flash), with upload + crop. -->
      <Border Grid.Column="2" Background="#B30D0D0E" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <Grid>
        <!-- section title in the corner: 10 px from the left and top of the preview column -->
        <TextBlock x:Name="PvTitle" Text="LIVE PREVIEW" Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
        <StackPanel Margin="28,34,28,0">
          <DockPanel LastChildFill="False">
            <CheckBox x:Name="PvIdle" DockPanel.Dock="Left" Style="{StaticResource Switch}" Content="Idle" VerticalAlignment="Center" Margin="0,0,14,0"
                      ToolTip="Show and change the picture the cooler displays by itself"/>
            <!-- rotate arrow (top-right, level with the Idle switch on the left): turns everything on the LCD by 90° -->
            <Button x:Name="RotateBtn" DockPanel.Dock="Right" VerticalAlignment="Center" Width="30" Height="30" Cursor="Hand"
                    ToolTip="Rotate 90° (saved; turns the live picture and the idle screen)">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="b" CornerRadius="15" Background="#E6131314" BorderBrush="{StaticResource LineHi}" BorderThickness="1">
                    <TextBlock x:Name="ic" Text="&#xE7AD;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Text}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                      <Setter TargetName="b" Property="Effect" Value="{StaticResource GlowSoft}"/>
                      <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DockPanel>
          <Grid Width="344" Height="344" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Ellipse StrokeThickness="4" Margin="2">
              <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <LinearGradientBrush.RelativeTransform><RotateTransform CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="#FF1F4B" Offset="0"/>
                  <GradientStop Color="#FFE600" Offset="0.25"/>
                  <GradientStop Color="#00E1FF" Offset="0.5"/>
                  <GradientStop Color="#7A4BFF" Offset="0.75"/>
                  <GradientStop Color="#FF2BD6" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Stroke>
              <Ellipse.Effect><DropShadowEffect Color="#FF1F4B" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(Ellipse.Stroke).(Brush.RelativeTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Fill="Black" Margin="8"/>
            <Image x:Name="Preview" Margin="8" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip><EllipseGeometry Center="164,164" RadiusX="164" RadiusY="164"/></Image.Clip>
            </Image>
            <Image x:Name="IdlePreview" Margin="8" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed">
              <Image.Clip><EllipseGeometry Center="164,164" RadiusX="164" RadiusY="164"/></Image.Clip>
            </Image>
            <!-- upload / read progress around the preview -->
            <Path x:Name="IdleRing" Stroke="{StaticResource Accent2}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False">
              <Path.Effect><DropShadowEffect Color="#00E1FF" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Path.Effect>
            </Path>
            <!-- coolant temperature over the idle picture: centred in the top half of the circle (25 % from the top) -->
            <Grid Margin="8" IsHitTestVisible="False">
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel x:Name="IdleTemp" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <!-- 5 % of the 328 px circle lower than the quarter line -->
                <StackPanel.RenderTransform><TranslateTransform Y="16"/></StackPanel.RenderTransform>
                <TextBlock x:Name="IdleTempNum" FontSize="64" Foreground="White" VerticalAlignment="Top"/>
                <!-- half-size degree sign; its top margin (set in code) lines its top up with the digits' top -->
                <TextBlock x:Name="IdleTempDeg" Text="°" FontSize="32" FontWeight="Normal" Foreground="White" VerticalAlignment="Top"/>
                <TextBlock x:Name="IdleTempC" Text="C" FontSize="64" Foreground="White" VerticalAlignment="Top"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="IdleEmpty" Text="No idle image yet" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <!-- live: YouTube-style pause/play that fades in on hover; click anywhere on the preview to toggle -->
            <Grid x:Name="PvHover" Margin="8" Background="Transparent" Cursor="Hand">
              <Grid.Clip><EllipseGeometry Center="164,164" RadiusX="164" RadiusY="164"/></Grid.Clip>
              <Border x:Name="PauseBtn" Width="76" Height="76" CornerRadius="38" Background="#99000000" BorderBrush="#55FFFFFF" BorderThickness="1"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="PauseIcon" Text="&#xE769;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <Ellipse x:Name="IdleHit" Margin="8" Fill="Transparent" Visibility="Collapsed"/>
          </Grid>

          <!-- live: connection + pause -->
          <StackPanel x:Name="LivePanel">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,24,0,0">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="#555" VerticalAlignment="Center">
                      <Ellipse.Effect><DropShadowEffect Color="#2BE36B" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="ConnText" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </StackPanel>
                  <TextBlock x:Name="FpsBig" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource StatusText}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="ModeText" Margin="0,6,0,0" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>          </StackPanel>

          <!-- idle: the picture stored on the cooler; choose, crop and upload a new one -->
          <StackPanel x:Name="IdlePanel" Visibility="Collapsed">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,24,0,0">
              <StackPanel>
                <TextBlock x:Name="IdleTitle" Text="Idle image" FontWeight="SemiBold"/>
                <TextBlock x:Name="IdleHint" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="The cooler shows this by itself when the PC isn't driving the screen (boot, sleep, powered off)."/>
                <StackPanel x:Name="IdleEdit" Visibility="Collapsed" Margin="0,12,0,0">
                  <DockPanel>
                    <TextBlock Text="Zoom" Style="{StaticResource Label}" Width="48"/>
                    <TextBlock x:Name="IdleZoomT" DockPanel.Dock="Right" Width="44" Style="{StaticResource Value}"/>
                    <Slider x:Name="IdleZoom" Minimum="1" Maximum="5" Value="1"/>
                  </DockPanel>
                  <TextBlock x:Name="IdleInfo" Foreground="{StaticResource StatusText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ProgressBar x:Name="IdleProgress" Margin="0,12,0,0" Maximum="100" Height="6" Foreground="{StaticResource Accent2}" Visibility="Collapsed"/>
                <TextBlock x:Name="IdleStatus" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="IdleBrowse" Style="{StaticResource Btn}" Content="Choose image…" Margin="0,0,8,8"/>
              <Button x:Name="IdleRead" Style="{StaticResource Btn}" Content="Read from cooler" Margin="0,0,8,8"/>
              <Button x:Name="IdleStore" Style="{StaticResource AccentBtn}" Content="Upload to cooler" Margin="0,0,8,8" Visibility="Collapsed"/>
              <Button x:Name="IdleCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,8" Visibility="Collapsed"/>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
